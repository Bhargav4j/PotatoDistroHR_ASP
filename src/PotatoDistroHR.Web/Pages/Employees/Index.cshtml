@page
@model EmployeesIndexModel
@{
    ViewData["Title"] = "Employees";
}

<h1>Employees</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New Employee</a>
</p>

@if (Model.Employees != null && Model.Employees.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Department</th>
                <th>Contact</th>
                <th>Salary</th>
                <th>Start Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model.Employees)
            {
                <tr>
                    <td>@employee.Id</td>
                    <td>@employee.FirstName @employee.LastName</td>
                    <td>@employee.Department?.Name</td>
                    <td>@employee.Contact</td>
                    <td>$@employee.Salary.ToString("N2")</td>
                    <td>@employee.StartDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-page="Details" asp-route-id="@employee.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-page="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-page="Delete" asp-route-id="@employee.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No employees found.</p>
}
