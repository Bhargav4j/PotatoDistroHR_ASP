@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Potato Distro HR</h1>
    <p>Human Resources Management System</p>

    @if (Model.IsAuthenticated)
    {
        <div class="row mt-5">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Employees</h5>
                        <p class="card-text">Manage employee records</p>
                        <a asp-page="/Employees/Index" class="btn btn-primary">View Employees</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Departments</h5>
                        <p class="card-text">Manage departments</p>
                        <a asp-page="/Departments/Index" class="btn btn-primary">View Departments</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Payroll</h5>
                        <p class="card-text">Manage payroll</p>
                        <a asp-page="/Payroll/Index" class="btn btn-primary">View Payroll</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <p class="mt-5">
            <a asp-page="/Auth/Login" class="btn btn-primary btn-lg">Login to continue</a>
        </p>
    }
</div>
